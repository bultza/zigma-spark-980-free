#!/bin/sh
# zigma-modular-cron-v1
# Only manage crond processes using our persistent crontab directory.
set -eu
PATH=/bin:/usr/bin:/sbin:/usr/sbin
export PATH
unset TZ
folder=/root/etc/crontabs
owned() {
 test "/proc/$1/exe" -ef /usr/sbin/crond || return 1
 test -r "/proc/$1/cmdline" || return 1
 tr '\000' '\n' < "/proc/$1/cmdline" | awk -v wanted="$folder" 'prev=="-c" && $0==wanted {ok=1} {prev=$0} END{exit !ok}'
}
stop() {
 for pid in $(pidof crond 2>/dev/null || true); do
  owned "$pid" || { echo 'Unmanaged crond; refusing to stop it' >&2; return 1; }
  kill "$pid"
 done
 for attempt in 1 2; do
  test -n "$(pidof crond 2>/dev/null || true)" || return 0
  sleep 1
 done
 test -z "$(pidof crond 2>/dev/null || true)" && return 0
 echo 'crond did not stop' >&2; return 1
}
start() {
 /root/zigma-free/zigma-cron ensure
}
case "${1:-}" in
 start) start;;
 stop) stop;;
 restart|reload) stop; start;;
 *) exit 2;;
esac
